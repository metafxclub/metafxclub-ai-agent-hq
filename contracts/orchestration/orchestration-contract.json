  "aiTradeCouncilAutoAnalysis": {
    "endpoint": "GET/POST /api/ai-trade-council/automation",
    "runtimeStore": "data/runtime/ai-trade-council-automation.json",
    "defaultEnabled": false,
    "triggerPolicy": "new_closed_bar",
    "activationPolicy": "wait_next_closed_bar",
    "barIdentityFields": ["candidateId", "symbol", "timeframe", "lastClosedBarTime"],
    "snapshotPollSeconds": 5,
    "settleSeconds": 10,
    "supportedTimeframes": ["M5", "M15", "M30", "H1", "H4", "D1", "W1", "MN1"],
    "manualOnlyTimeframes": ["M1"],
    "analysisOrder": [
      {"agentId": "optimization_agent", "roleId": "technical", "scope": "core14_indicator_module_summaries_plus_bounded_recent_series"},
      {"agentId": "backtest_analyst", "roleId": "price_action", "scope": "full_window_swing_sr_trendline_fibonacci_rsi_macd_divergence_features_plus_max_500_recent_ohlc"},
      {"agentId": "codex_mcp_operator", "roleId": "news", "scope": "short_medium_long_current_context"}
    ],
    "consensusPolicy": {
      "requiredVotes": 3,
      "allowedRequiredVotes": [1, 2, 3],
      "directionalAgreement": "configurable_n_of_three_with_opposite_direction_veto",
      "holdPolicy": "abstain_from_directional_count",
      "oppositeDirectionPolicy": "any_buy_and_sell_means_no_trade",
      "configurationEffectiveFrom": "next_analysis_round",
      "protectivePriceAggregation": "price_action_single_owner_or_backend_deterministic_fallback",
      "protectivePlanSources": [
        "price_action_agent",
        "backend_deterministic_fallback",
        "unavailable"
      ],
      "protectivePlanFallback": {
        "schemaVersion": "ai-trade-council-protective-plan-v1",
        "source": "backend_deterministic_fallback",
        "policyVersion": "metafx-protective-plan-atr-structure-v1",
        "eligibleOnlyWhen": "price_action_hold_and_directional_consensus_otherwise_qualifies",
        "ownerRole": "backend_deterministic_guard",
        "closedBarsOnly": true,
        "sameSnapshotRequired": true,
        "snapshotArtifactDigestRequired": true,
        "snapshotArtifactPathPattern": "ai-trade-council/snapshots/<artifact-sha256>.json",
        "technicalNoDataAllowed": false,
        "priceActionNoDataAllowed": false,
        "modelCallAllowed": false,
        "terminalActionAllowed": false,
        "minimumRewardRiskRatioSource": "backend_quality_policy",
        "failurePolicy": "fail_closed_no_trade"
      },
      "actionableFields": ["direction", "stopLossPrice", "takeProfitPrice"],
      "forbiddenAiFields": ["lot", "lots", "fixedLot", "volume", "positionSize", "riskPercent"],
      "lotSource": "mt4_ea_input_only"
    },
    "decisionHorizonPolicy": {
      "validUntilBarTimeDomain": "mt4_broker_clock",
      "validUntilBarTimeUse": "specialist_vote_and_bar_identity_only",
      "decisionExpirySource": "round_deadline_at_utc",
      "missingOrInvalidRoundDeadlinePolicy": "fail_closed_no_dispatch",
      "crossBrokerOffsetPolicy": "never_interpret_raw_mt4_itime_as_utc_or_infer_offset"
    },
    "managedOrderPolicy": {
      "configField": "maxManagedOrders",
      "default": 1,
      "allowedValues": [1, 3, 5, 10],
      "source": "backend_dispatch_cap",
      "scope": "account_managed_magic_numbers",
      "effectiveRule": "min(maxManagedOrders, eaMaxManagedPositions)",
      "currentPositionRule": "max(freshEaCurrentManagedPositions, selectedChannelDurableExecutedAckOpenOrUnknownCount)",
      "missingTelemetryPolicy": "fail_closed_before_command_publish",
      "existingPositionPolicy": "never_force_close",
      "eaInputChanged": false,
      "eaFinalGuardRequired": true
    },
    "backlogPolicy": "durable_fifo_exact_snapshot_audit_only_when_stale",
    "coveragePolicy": {
      "storeVersion": "ai-trade-council-automation-store-v2",
      "futureObservedBars": "capture_immutable_snapshot_and_enqueue_once",
      "sameBarPolicy": "idempotent_once",
      "restartAndJumpWithoutSnapshot": "explicit_skipped_record",
      "staleSnapshotTradePolicy": "never_dispatch_trade_command",
      "pendingQueueOrder": "oldest_closed_bar_first",
      "maximumRunnablePending": 512,
      "pendingCapacityPolicy": "terminal_skip_pending_queue_capacity_exceeded",
      "missingDurableSnapshotPolicy": "terminal_skip_before_transient_runtime_gates",
      "bangkokDayRolloverPolicy": "terminal_skip_prior_day_pending_and_publish_terminal_state_when_queue_empties",
      "retentionPolicy": "preserve_all_runnable_pending_then_newest_terminal_evidence",
      "historyInvariant": "expected_equals_analyzed_plus_skipped_plus_pending_plus_queued"
    },
    "dailyRoundLimitMode": "unlimited",
    "dailyRoundLimitEnabled": false,
    "maxDailyRounds": 24,
    "effectiveMaxDailyRounds": null,
    "maxDailyRoundsCompatibilityNote": "Stored legacy limit used only when dailyRoundLimitMode is limited; unlimited analyzes each newly closed supported candle subject to runtime gates.",
    "defaultMinRemainingPercent": 15,
    "freshRateLimitRequired": true,
    "fullAccessRequired": true,
    "singleCouncilRoundAtATime": true,
    "oneAutomaticRoundPerClosedBar": true,
    "browserIndependent": true,
    "terminalActions": "analysis_agents_false_backend_gateway_conditional",
    "liveOrderSubmission": "ea_local_mode_and_live_arm_only",
    "postConsensusGateway": {
      "adapter": "MetafxHQTradeGateway",
      "defaultMode": "shadow",
      "executionModeSource": "mt4_ea_input_only",
      "fixedLotSource": "mt4_ea_input_only",
      "commandTransport": "FILE_COMMON_flat_json",
      "requiresFreshHeartbeat": true,
      "oneOrderPerBar": true,
      "liveRequiresLocalEaArm": true,
      "humanApprovalPerOrder": false,
      "executionAuthorizationSource": "persistent_local_ea_mode_and_live_armed_inputs",
      "frontendMayChangeAuthorization": false
    },
    "auditEvents": [
      "ai_trade_council.auto_config_changed",
      "ai_trade_council.auto_baseline",
      "ai_trade_council.auto_bar_detected",
      "ai_trade_council.auto_queued",
      "ai_trade_council.auto_paused",
      "ai_trade_council.trade_gateway_published",
      "mt4_trade_gateway.ack_ingested",
      "mt4_trade_gateway.command_expired"
    ]
  },
